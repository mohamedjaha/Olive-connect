@startuml OliveConnect_V3
title OliveConnect - Diagramme de classes métier (V3)
left to right direction
skinparam classAttributeIconSize 0
skinparam shadowing false
skinparam classBackgroundColor #FFFFFF
skinparam classBorderColor #557A46
skinparam ArrowColor #555555
skinparam nodesep 35
skinparam ranksep 45
hide empty methods

class Utilisateur {
  - id : String
  - nom : String
  - prenom : String
  - email : String
  - telephone : String [0..1]
  - role : Role
  - actif : Boolean
}
class Verger {
  - id : String
  - nom : String
  - superficieHa : Double
  - variete : String
  - localisation : Localisation
  - maturite : Double [0..1]
  - statut : StatutVerger
}
class DemandeRecolte {
  - id : String
  - type : TypeDemande
  - dateSouhaitee : LocalDate
  - dateCreation : Instant
  - statut : StatutDemande
  - motif : String [0..1]
}
class Alerte {
  - id : String
  - type : TypeAlerte
  - description : String
  - dateCreation : Instant
  - localisation : Localisation
  - statut : StatutAlerte
  - historique : TraitementAlerte [0..*]
}
class Tournee {
  - id : String
  - dateDebut : Instant
  - dateFin : Instant
  - statut : StatutTournee
  - /avancement : Double
}
class EtapeCollecte <<objet secondaire>> {
  - ordre : Integer
  - avancement : Double
  - quantiteRecolteeKg : Double
  - dateDebutReelle : Instant [0..1]
  - dateFinReelle : Instant [0..1]
}
class Ressource {
  - id : String
  - nom : String
  - categorie : CategorieRessource
  - etat : EtatRessource
  - indisponibilites : Creneau [0..*]
}
class Affectation {
  - id : String
  - debut : Instant
  - fin : Instant
  - statut : StatutAffectation
}
class Pressoir {
  - id : String
  - nom : String
  - localisation : Localisation
  - capaciteTotaleKg : Double
  - /capaciteDisponibleKg : Double
}
class Reception {
  - id : String
  - poidsPrevuKg : Double [0..1]
  - poidsKg : Double [0..1]
  - qualite : QualiteOlive [0..1]
  - dateReception : Instant [0..1]
  - statut : StatutReception
  - origine : String [0..1]
}
class Notification {
  - id : String
  - type : TypeNotification
  - message : String
  - dateCreation : Instant
  - lu : Boolean = false
  - objetId : String
}
class MesureExterne {
  - id : String
  - source : String
  - type : TypeMesure
  - valeur : Double
  - unite : String
  - dateMesure : Instant
  - localisation : Localisation [0..1]
}

Utilisateur "1" -- "0..*" Verger : possède
Utilisateur "1" -- "0..*" DemandeRecolte : déclare
Utilisateur "1" -- "0..*" Alerte : signale
Utilisateur "1" -- "0..*" Notification : reçoit
Utilisateur "1" -- "0..*" Tournee : dirige
Verger "1" -- "0..*" DemandeRecolte : concerne
Verger "1" -- "0..*" Alerte : concerne
Tournee "1" *-- "1..*" EtapeCollecte : contient
Verger "1" -- "0..*" EtapeCollecte : concerne
DemandeRecolte "0..1" -- "0..*" EtapeCollecte : planification
Tournee "1" -- "0..*" Affectation : mobilise
Ressource "1" -- "0..*" Affectation : réservations
Tournee "0..1" -- "0..*" Reception : origine
Pressoir "1" -- "0..*" Reception : reçoit
Utilisateur "0..*" -- "0..*" Pressoir : gère
Utilisateur "0..1" -- "0..*" Reception : confirme
Verger "0..1" -- "0..*" MesureExterne : maturité / météo
Pressoir "0..1" -- "0..*" MesureExterne : capacité
@enduml
