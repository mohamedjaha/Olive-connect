# Authentification
# "mock"   : comptes de démonstration (aucun backend requis)
# "google" : jeton d'identité Google réel, validé par le backend
VITE_AUTH_MODE=mock

# Client OAuth 2.0 Google, type "Web application".
# Origines JavaScript autorisées dans Google Cloud Console :
#   http://localhost:5173
# Le client secret ne sert qu'au backend : ne jamais le placer ici.
VITE_GOOGLE_CLIENT_ID=

# Mocks MSW. Passer à "false" pour appeler le backend Spring Boot (port 8081).
# Les mocks sont de toute façon désactivés en mode "google".
VITE_ENABLE_MOCKS=true
